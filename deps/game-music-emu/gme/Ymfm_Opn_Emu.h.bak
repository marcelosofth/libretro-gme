// YM2203 (OPN) sound chip emulator interface, backed by Aaron Giles' `ymfm`
// library (BSD-3-Clause). Unlike the pure-FM chips (YM2151, YM3812, YM3526),
// YM2203 has an embedded SSG (AY-3-8910-style PSG) alongside its FM engine.
// ymfm exposes them as separate, unmixed output channels: index 0 is the
// mono FM signal, indices 1-3 are the three SSG channels (A/B/C) separately.
// We sum all four into one mono signal here and duplicate to L/R, same as
// the OPL-family adapter does for its single mono channel.

// Game_Music_Emu https://bitbucket.org/mpyne/game-music-emu/
#ifndef YMFM_OPN_EMU_H
#define YMFM_OPN_EMU_H

#include "ymfm_opn.h"

class Ymfm_Opn_Emu : public ymfm::ymfm_interface {
public:
	Ymfm_Opn_Emu() : chip( *this ) { }

	const char* set_rate( double sample_rate, double clock_rate )
	{
		(void) sample_rate;
		(void) clock_rate;
		return NULL;
	}

	void reset()
	{
		chip.reset();
	}

	enum { channel_count = 3 + 3 }; // 3 FM channels + 3 SSG channels
	void mute_voices( int mask ) { (void) mask; }

	// Same address-then-data pattern as the other single-port chips.
	void write( int addr, int data )
	{
		chip.write( 0, (unsigned char) addr );
		chip.write( 1, (unsigned char) data );
	}

	// Run and add pair_count samples into current output buffer contents.
	// output.data[0] = FM (mono), [1..3] = SSG channels A/B/C, unmixed by
	// ymfm on purpose (so callers can pan them individually if they want).
	// We just sum everything into one mono signal and duplicate to L/R.
	typedef short sample_t;
	enum { out_chan_count = 2 };
	void run( int pair_count, sample_t* out )
	{
		for ( int i = 0; i < pair_count; i++ )
		{
			ymfm::ym2203::output_data output;
			chip.generate( &output, 1 );
			output.clamp16();
			int mono = 0;
			for ( unsigned c = 0; c < ymfm::ym2203::OUTPUTS; c++ )
				mono += output.data [c];
			if ( mono > 32767 ) mono = 32767;
			if ( mono < -32768 ) mono = -32768;
			out [0] = (sample_t) (out [0] + mono);
			out [1] = (sample_t) (out [1] + mono);
			out += 2;
		}
	}

	uint32_t sample_rate( uint32_t input_clock ) const
	{
		return chip.sample_rate( input_clock );
	}

private:
	ymfm::ym2203 chip;
};

#endif